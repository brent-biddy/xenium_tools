# ===== Base image (from your Singularity 'Bootstrap: docker' + 'From: ...') =====
FROM bioconductor/bioconductor_docker:3.21

# Use bash with strict mode for all RUN lines
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ===== Labels (from %labels) =====
LABEL maintainer="Brent Biddy <your.email@institution.edu>" \
      org.opencontainers.image.authors="Brent Biddy <your.email@institution.edu>" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.title="Seurat environment for Xenium spatial transcriptomics analysis" \
      org.opencontainers.image.description="R + Seurat/Signac workspace for 10x Genomics Xenium data; base: bioconductor/bioconductor_docker:3.21" \
      org.opencontainers.image.base.name="bioconductor/bioconductor_docker:3.21"

# ===== Help text (from %help) written to a file =====
RUN mkdir -p /usr/local/share && cat > /usr/local/share/container-help.txt <<'EOF'
This container provides an R environment with Seurat and dependencies
for processing 10x Genomics Xenium spatial transcriptomics data.

Included packages:
- Seurat, SeuratObject (single-cell/spatial RNA-seq analysis)
- Signac (chromatin accessibility analysis)
- patchwork (plot composition)
- data.table, dplyr (data manipulation)
- argparse (command-line argument parsing)
- R.utils (utilities)
- arrow (Apache Arrow for data interchange)
- IRkernel (Jupyter R kernel)
- nbconvert (Jupyter notebook conversion)

Usage:
  docker run --rm -it <image> --version
  docker run --rm -it <image> -e "print('hello from R')"

If converted to SIF:
  singularity exec seurat.sif Rscript your_script.R
  singularity exec seurat.sif jupyter nbconvert notebook.ipynb
EOF

# ===== Environment (from %environment) =====
ENV R_LIBS_USER=/usr/local/lib/R/site-library \
    R_LIBS=/usr/local/lib/R/site-library \
    R_LIBS_SITE=/usr/local/lib/R/site-library \
    JUPYTER_PATH=/usr/local/share/jupyter \
    JUPYTER_CONFIG_DIR=/usr/local/etc/jupyter \
    R_REMOTES_NO_ERRORS_FROM_WARNINGS=true \
    RETICULATE_PYTHON=/usr/bin/python3 \
    # Allow pip to install alongside distro packages (Debian/Ubuntu PEP 668)
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    DEBIAN_FRONTEND=noninteractive

# ===== System deps + Python tools + R packages (from %post) =====
RUN set -euxo pipefail \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libhdf5-dev \
      libgeos-dev \
      libproj-dev \
      libudunits2-dev \
      libgdal-dev \
      libglpk-dev \
      pandoc \
 && rm -rf /var/lib/apt/lists/* \
 \
 # Python packages for Jupyter
 && python3 -m pip install --no-cache-dir \
      nbconvert \
      jupyter \
      ipykernel \
      matplotlib \
 \
 # R packages (CRAN + Bioconductor) and IRkernel registration
 && R --slave --no-save --no-restore-history -e "\
    options(repos = c(CRAN = 'https://cloud.r-project.org')); \
    install.packages(c('BiocManager','remotes','IRkernel'), \
                     Ncpus = parallel::detectCores()); \
    remotes::install_version(package = 'arrow', version = '21.0.0', \
                             upgrade = 'never', \
                             Ncpus = parallel::detectCores()); \
    BiocManager::install(c('Seurat','SeuratObject','Signac', \
                           'patchwork','data.table','dplyr', \
                           'argparse','R.utils'), \
                         update = FALSE, ask = FALSE, \
                         Ncpus = parallel::detectCores()); \
    IRkernel::installspec(name = 'ir', displayname = 'R (Seurat)', user = FALSE); \
    pkgs <- c('Seurat','SeuratObject','Signac','patchwork','data.table','dplyr', \
              'argparse','R.utils','arrow','IRkernel'); \
    ok <- sapply(pkgs, requireNamespace, quietly = TRUE); \
    if (!all(ok)) stop('Not all required packages were installed successfully'); \
    cat('All required packages installed successfully\\n'); \
    for (p in pkgs) cat(sprintf('%s: %s\\n', p, as.character(utils::packageVersion(p)))); \
 " \
 \
 # Clean up
 && apt-get clean