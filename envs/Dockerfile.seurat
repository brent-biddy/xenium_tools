FROM bioconductor/bioconductor_docker:3.21

# Labels
LABEL Author="Brent Biddy" \
      Version="1.0.0" \
      Description="Seurat environment for Xenium spatial transcriptomics analysis"

# Environment variables
ENV R_LIBS_USER=/usr/local/lib/R/site-library \
    R_LIBS_SITE=/usr/local/lib/R/site-library \
    JUPYTER_PATH=/usr/local/share/jupyter \
    JUPYTER_CONFIG_DIR=/usr/local/etc/jupyter \
    R_REMOTES_NO_ERRORS_FROM_WARNINGS=true \
    RETICULATE_PYTHON=/usr/bin/python3 \
    # Allow pip to install alongside distro packages (Debian/Ubuntu PEP 668)
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    DEBIAN_FRONTEND=noninteractive

# ===== System deps + Python tools + R packages (from %post) =====
RUN set -euxo pipefail \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libhdf5-dev \
      libgeos-dev \
      libproj-dev \
      libudunits2-dev \
      libgdal-dev \
      libglpk-dev \
      pandoc \
 && rm -rf /var/lib/apt/lists/* \
 \
 # Python packages for Jupyter
 && python3 -m pip install --no-cache-dir \
      nbconvert \
      jupyter \
      ipykernel \
      matplotlib \
 \
 # R packages (CRAN + Bioconductor) and IRkernel registration
 && R --slave --no-save --no-restore-history -e "\
    options(repos = c(CRAN = 'https://cloud.r-project.org')); \
    install.packages(c('BiocManager','remotes','IRkernel'), \
                     Ncpus = parallel::detectCores()); \
    remotes::install_version(package = 'arrow', version = '21.0.0', \
                             upgrade = 'never', \
                             Ncpus = parallel::detectCores()); \
    BiocManager::install(c('Seurat','SeuratObject','Signac', \
                           'patchwork','data.table','dplyr', \
                           'argparse','R.utils', 'glmGamPoi'), \
                         update = FALSE, ask = FALSE, \
                         Ncpus = parallel::detectCores()); \
    remotes::install_github(c('satijalab/seurat-data', 'satijalab/azimuth', 'satijalab/seurat-wrappers', 'immunogenomics/presto', 'bnprks/BPCells/r'), quiet = TRUE, upgrade = 'never'); \
    IRkernel::installspec(name = 'ir', displayname = 'R (Seurat)', user = FALSE); \
    pkgs <- c('Seurat','SeuratObject','Signac','patchwork','data.table','dplyr', \
              'argparse','R.utils','arrow','IRkernel'); \
    ok <- sapply(pkgs, requireNamespace, quietly = TRUE); \
    if (!all(ok)) stop('Not all required packages were installed successfully'); \
    cat('All required packages installed successfully\\n'); \
    for (p in pkgs) cat(sprintf('%s: %s\\n', p, as.character(utils::packageVersion(p)))); \
 " \
 \
 # Clean up
 && apt-get clean