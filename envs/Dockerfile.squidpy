FROM mambaorg/micromamba:1.5.8

ENV JUPYTER_PATH=/usr/local/share/jupyter \
    JUPYTER_CONFIG_DIR=/usr/local/etc/jupyter \
    PATH=/opt/conda/envs/python_squidpy/bin:$PATH \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    MPLCONFIGDIR=/tmp/matplotlib

USER root

# System dependencies required by numba and OpenGL-dependent packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libgl1 \
    libxext6 \
    libsm6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/numba_cache /tmp/matplotlib && chmod 777 /tmp/numba_cache /tmp/matplotlib

USER $MAMBA_USER

# Layer 1: Create mamba environment from YAML
COPY --chown=$MAMBA_USER:$MAMBA_USER squidpy_env.yml /tmp/squidpy_env.yml
RUN micromamba env create -f /tmp/squidpy_env.yml && \
    micromamba clean --all --yes

# Layer 2: Register Jupyter kernel (most likely to change)
RUN python -m ipykernel install --sys-prefix --name python_squidpy --display-name "python_squidpy"
