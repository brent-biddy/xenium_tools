

params {

    // --- Required ---
    samplesheet = ''
    output_path = './'

    // --- Top-level workflow dispatch ---
    run_object_creation = true   // run OBJECT_CREATION workflow for directory inputs
    run_seurat_rds      = false  // run SEURAT workflow for pre-built RDS inputs

    // --- Object creation processes ---
    run_create_seurat       = true   // create_seurat_object
    run_create_bpcells      = false  // create_bpcells_seurat_object
    run_create_spatialdata  = true   // create_spatialdata_object
    run_qc_plots            = true   // xenium_qc_plots
    run_downsample          = true   // run downsample_seurat_object process
    downsample_fraction     = 0.1    // fraction of cells to sample per spatial bin
    downsample_bin_size     = 50     // spatial bin side length in microns

    // --- Seurat analysis processes ---
    cluster             = false  // sketch_cluster_seurat
    cluster_full        = false  // cluster_seurat
    run_cluster_plots   = false  // seurat_cluster_plots (only runs when cluster_full = true)
    score_markers       = false  // seurat_score_markers
    bp_clustering                = false  // bp_cells_clustering
    run_squidpy_notebook                = false  // execute_squidpy_notebook
    run_squidpy_marker_workflow         = false  // execute_squidpy_marker_workflow
    run_squidpy_resegment               = false  // execute_squidpy_resegment
    run_squidpy_resegment_multichannel  = false  // execute_squidpy_resegment_multichannel
    resegment_cell_id                   = ''
    resegment_stage                     = ''     // one of: primordial, primary, secondary, antral
    resegment_cyto_channel              = 1
    resegment_nucleus_channel           = 0

    // --- Paths ---
    marker_yaml         = "${projectDir}/refs/ovary_markers.yaml"
    squidpy_marker_yaml = "${projectDir}/refs/ovary_markers.yaml"
}

process {
    withLabel: seurat {
        container = 'babiddy755/xenium_tools_seurat:f015b361af6e39fca9f36332319e87359781b181'
    }
    withLabel: squidpy {
        container = 'babiddy755/xenium_tools_squidpy:27a607daeef10cc62ec481076475fcc326987401'
    }
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }

    singularity {
        docker.enabled = false
        singularity.enabled = true
        apptainer.enabled = false
        process.executor = 'local'
        singularity.runOptions = '--writable-tmpfs'
    }

    docker {
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        process.executor = 'local'
    }

    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        process.executor = 'local'
        apptainer.pullTimeout = "30m"
    }

    oscer {
        process.executor = 'slurm'
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.runOptions = '--writable-tmpfs'
        process.errorStrategy = 'retry'
        process.maxRetries = 3
        process.memory = { 32.GB * ( 1 + task.attempt) }
        process.cpus = 8
        process.queue = 'normal'
    }
}

trace {
    enabled = true
    file = "${params.output_path}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.output_path}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.output_path}/pipeline_info/execution_report.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.output_path}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

manifest {
    name = 'xenium_tools'
    author = 'Brent Biddy'
    homePage = 'https://github.com/yourusername/xenium_tools'
    description = 'Nextflow workflow to process 10x Genomics Xenium datasets'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version = '1.0.0'
}
